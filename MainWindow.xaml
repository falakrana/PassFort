<Window x:Class="PasswordManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PasswordManager.ViewModels"
        xmlns:helpers="clr-namespace:PasswordManager.Helpers"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVis"/>
        <helpers:InverseNullToVisibilityConverter x:Key="InvNullToVis"/>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#9CA3AF"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input TextBox Style -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Application Top Header Bar -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔐 " FontSize="22"/>
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="+ Add Password" 
                        Command="{Binding AddNewCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        HorizontalAlignment="Right" 
                        Padding="16,8"/>
            </Grid>
        </Border>

        <!-- Main Master-Detail Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Password List (Master View) -->
            <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="15,12" Background="#E2E8F0">
                        <TextBlock Text="ALL PASSWORDS" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                    </Border>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding PasswordEntries}" 
                             SelectedItem="{Binding SelectedEntry}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="8,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="White" CornerRadius="8" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3B82F6"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#93C5FD"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#E0F2FE" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#0369A1"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Username}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: Details / Edit Form / Empty State -->
            <Grid Grid.Column="1" Margin="25">
                <!-- VIEW 1: READ / DETAIL MODE -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEditing}" Value="False"/>
                                        <Condition Binding="{Binding IsAdding}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Background="White" CornerRadius="12" Padding="25" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
                            </Border.Effect>

                            <StackPanel>
                                <!-- Top Bar of Detail Card -->
                                <DockPanel Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding SelectedEntry.Title}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <Border Background="#E0F2FE" CornerRadius="6" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedEntry.Category}" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button Content="✏️ Edit" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                        <Button Content="🗑️ Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButtonStyle}"/>
                                    </StackPanel>
                                </DockPanel>

                                <Separator Background="#E2E8F0" Margin="0,0,0,20"/>

                                <!-- Username Field -->
                                <TextBlock Text="USERNAME / EMAIL" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedEntry.Username, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="16" Foreground="#0F172A" Margin="0,0,0,16"/>

                                <!-- Password Field with Masking Toggle -->
                                <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Masked Password -->
                                    <TextBlock Grid.Column="0" Text="••••••••••••••••" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"
                                               Visibility="{Binding IsPasswordVisible, Converter={StaticResource InvBoolToVis}}"/>

                                    <!-- Unmasked Password -->
                                    <TextBox Grid.Column="0" Text="{Binding SelectedEntry.Password, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="16" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"
                                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"/>

                                    <Button Grid.Column="1" 
                                            Content="{Binding IsPasswordVisible, Converter={StaticResource InvBoolToVis}, ConverterParameter='Show'}" 
                                            Command="{Binding TogglePasswordVisibilityCommand}" 
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>

                                <!-- Website Field -->
                                <TextBlock Text="WEBSITE URL" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedEntry.WebsiteUrl, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="14" Foreground="#2563EB" Margin="0,0,0,16"/>

                                <!-- Notes Field -->
                                <TextBlock Text="NOTES" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding SelectedEntry.Notes}" FontSize="13" Foreground="#334155" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Timestamps -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Created: " FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding SelectedEntry.CreatedAt, StringFormat={}{0:g}}" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 2: ADD / EDIT FORM MODE -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAdding}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Background="White" CornerRadius="12" Padding="25" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding IsAdding, Converter={StaticResource BoolToVis}, ConverterParameter='Add New Password'}" 
                                           FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"
                                           Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="Edit Password Entry" 
                                           FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"
                                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>

                                <!-- Validation Error Alert -->
                                <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15"
                                        Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#991B1B" FontWeight="SemiBold"/>
                                </Border>

                                <!-- Form Inputs -->
                                <TextBlock Text="Title *" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Text="{Binding EditingEntry.Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock Text="Username / Email" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Text="{Binding EditingEntry.Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock Text="Password *" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Text="{Binding EditingEntry.Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock Text="Website URL" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Text="{Binding EditingEntry.WebsiteUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock Text="Category" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Text="{Binding EditingEntry.Category, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock Text="Notes" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Text="{Binding EditingEntry.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" Style="{StaticResource FormTextBoxStyle}"/>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                                    <Button Content="Save Password" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Footer Status Bar -->
        <Border Grid.Row="2" Background="#E2E8F0" Padding="15,8">
            <DockPanel>
                <TextBlock Text="Status: " FontWeight="SemiBold" Foreground="#475569"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1E293B"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
