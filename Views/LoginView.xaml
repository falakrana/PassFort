<UserControl x:Class="PasswordManager.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:PasswordManager.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="650">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Background="#060D06">
        <Border Width="450"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#0D1A0D"
                BorderBrush="#00FF41"
                BorderThickness="1"
                CornerRadius="8"
                Padding="36"
                Effect="{DynamicResource ModalShadow}">

            <Grid>
                <!-- Main login / setup panel -->
                <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <!-- Lock Icon Header -->
                    <Border Background="#0F2B0F" BorderBrush="#00FF41" BorderThickness="1" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="ðŸ”’" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Title & Subtitle -->
                    <TextBlock Text="{Binding Title}"
                               FontSize="22"
                               FontWeight="Bold"
                               FontFamily="Consolas, Segoe UI"
                               Foreground="#00FF41"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="13"
                               FontFamily="Consolas, Segoe UI"
                               Foreground="#4A7A4A"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>

                    <!-- Error Message Banner -->
                    <Border Background="#2B0000"
                            BorderBrush="#FF2222"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10"
                            Margin="0,0,0,18"
                            Visibility="{Binding ErrorMessage, Converter={x:Static helpers:NullToVisibilityConverter.Instance}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="âš ï¸ " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#FF6666"
                                       FontFamily="Consolas, Segoe UI"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Recovery Success Banner (after recovery) -->
                    <Border Background="#0B2B0B"
                            BorderBrush="#00FF41"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,0,0,14"
                            Visibility="{Binding RecoverySuccessMessage, Converter={x:Static helpers:NullToVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding RecoverySuccessMessage}"
                                   Foreground="#00FF41"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Password Input with Masking Toggle -->
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text=">_ MASTER PASSWORD"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   FontFamily="Consolas, Segoe UI"
                                   Foreground="#4A7A4A"
                                   DockPanel.Dock="Left" />
                        <Button Content="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}, StringFormat='ðŸ‘ï¸ Show', ConverterParameter='ðŸ‘ï¸ Hide'}"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                Foreground="#00FF41"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="11"
                                FontFamily="Consolas, Segoe UI"
                                FontWeight="Bold"
                                Cursor="Hand"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right" />
                    </DockPanel>

                    <!-- Masked Password Box -->
                    <Border BorderBrush="#1A5C1A"
                            BorderThickness="1"
                            Background="#060D06"
                            CornerRadius="4"
                            Padding="4"
                            Margin="0,0,0,6"
                            Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}}">
                        <PasswordBox x:Name="MasterPasswordBox"
                                     FontSize="14"
                                     FontFamily="Consolas, Segoe UI"
                                     Foreground="#C8FFC8"
                                     CaretBrush="#00FF41"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="6,4"
                                     helpers:PasswordBoxHelper.Attach="True"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <!-- Unmasked Password Box -->
                    <Border BorderBrush="#00FF41"
                            BorderThickness="1"
                            Background="#060D06"
                            CornerRadius="4"
                            Padding="4"
                            Margin="0,0,0,6"
                            Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 FontFamily="Consolas, Segoe UI"
                                 Foreground="#00FF41"
                                 CaretBrush="#00FF41"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="6,4" />
                    </Border>

                    <!-- Hint Row (shown only when vault exists and has a hint) -->
                    <DockPanel Margin="0,0,0,14"
                               Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}">
                        <Button Content="{Binding IsHintVisible, Converter={StaticResource BoolToVis}, StringFormat='ðŸ™ˆ Hide Hint', ConverterParameter='ðŸ’¡ Show Hint'}"
                                Command="{Binding ShowHintCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#4A7A4A"
                                FontFamily="Consolas, Segoe UI"
                                FontSize="11"
                                Cursor="Hand"
                                HorizontalAlignment="Left"
                                DockPanel.Dock="Left"/>
                    </DockPanel>

                    <!-- Hint Text Display -->
                    <Border Background="#0A1F0A"
                            BorderBrush="#1A5C1A"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,-8,0,14"
                            Visibility="{Binding IsHintVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ðŸ’¡ " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StoredHint}"
                                       Foreground="#C8FFC8"
                                       FontFamily="Consolas, Segoe UI"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Confirm Password Input (First Run Only) -->
                    <StackPanel Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text=">_ CONFIRM MASTER PASSWORD"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   FontFamily="Consolas, Segoe UI"
                                   Foreground="#4A7A4A"
                                   Margin="0,0,0,6" />

                        <Border BorderBrush="#1A5C1A"
                                BorderThickness="1"
                                Background="#060D06"
                                CornerRadius="4"
                                Padding="4"
                                Margin="0,0,0,12">
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         FontSize="14"
                                         FontFamily="Consolas, Segoe UI"
                                         Foreground="#C8FFC8"
                                         CaretBrush="#00FF41"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="6,4"
                                         helpers:PasswordBoxHelper.Attach="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>

                        <!-- Optional Password Hint (first run) -->
                        <TextBlock Text=">_ PASSWORD HINT  (optional)"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   FontFamily="Consolas, Segoe UI"
                                   Foreground="#4A7A4A"
                                   Margin="0,0,0,5"/>
                        <Border BorderBrush="#1A5C1A"
                                BorderThickness="1"
                                Background="#060D06"
                                CornerRadius="4"
                                Padding="4"
                                Margin="0,0,0,6">
                            <TextBox Text="{Binding HintInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13"
                                     FontFamily="Consolas, Segoe UI"
                                     Foreground="#C8FFC8"
                                     CaretBrush="#00FF41"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="6,4"/>
                        </Border>
                        <TextBlock Text="A vague reminder shown on the login screen. Don't put the actual password here."
                                   FontSize="10"
                                   FontFamily="Consolas, Segoe UI"
                                   Foreground="#3A5A3A"
                                   Margin="0,0,0,14"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Action Button: Setup Master Password (First Run) -->
                    <Button Content="CREATE MASTER PASSWORD &amp; UNLOCK"
                            Command="{Binding SetupCommand}"
                            IsDefault="True"
                            Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="42"
                            FontSize="13"
                            Margin="0,8,0,0" />

                    <!-- Action Button: Unlock Vault (Existing Vault) -->
                    <Button Content="ðŸ”“ UNLOCK VAULT"
                            Command="{Binding UnlockCommand}"
                            IsDefault="True"
                            Visibility="{Binding IsFirstRun, Converter={StaticResource InverseBoolToVis}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="42"
                            FontSize="14"
                            Margin="0,8,0,0" />

                    <!-- Forgot Password / Recovery Link (existing vault only) -->
                    <Button Content="Forgot password? Use recovery key â†’"
                            Command="{Binding ToggleRecoveryPanelCommand}"
                            Visibility="{Binding HasRecoveryKey, Converter={StaticResource BoolToVis}}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#3A6A3A"
                            FontFamily="Consolas, Segoe UI"
                            FontSize="11"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"/>

                    <!-- â”€â”€ Recovery Key Panel â”€â”€ -->
                    <Border Visibility="{Binding IsRecoveryPanelOpen, Converter={StaticResource BoolToVis}}"
                            Background="#020A02"
                            BorderBrush="#1A5C1A"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,14"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="ðŸ”‘ RECOVERY KEY"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       FontFamily="Consolas, Segoe UI"
                                       Foreground="#00FF41"
                                       Margin="0,0,0,10"/>

                            <!-- Recovery error -->
                            <Border Background="#2B0000" BorderBrush="#FF2222" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,10"
                                    Visibility="{Binding RecoveryErrorMessage, Converter={x:Static helpers:NullToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding RecoveryErrorMessage}" Foreground="#FF6666" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="RECOVERY KEY" FontSize="10" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" Margin="0,0,0,4"/>
                            <Border BorderBrush="#1A5C1A" BorderThickness="1" Background="#060D06" CornerRadius="4" Padding="4" Margin="0,0,0,10">
                                <TextBox Text="{Binding RecoveryKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13" FontFamily="Consolas, Segoe UI" Foreground="#C8FFC8"
                                         CaretBrush="#00FF41" Background="Transparent" BorderThickness="0" Padding="6,4"/>
                            </Border>

                            <TextBlock Text="NEW MASTER PASSWORD" FontSize="10" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" Margin="0,0,0,4"/>
                            <Border BorderBrush="#1A5C1A" BorderThickness="1" Background="#060D06" CornerRadius="4" Padding="4" Margin="0,0,0,10">
                                <PasswordBox FontSize="13" FontFamily="Consolas, Segoe UI" Foreground="#C8FFC8" CaretBrush="#00FF41"
                                             Background="Transparent" BorderThickness="0" Padding="6,4"
                                             helpers:PasswordBoxHelper.Attach="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding NewPasswordAfterRecovery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>

                            <TextBlock Text="CONFIRM NEW PASSWORD" FontSize="10" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" Margin="0,0,0,4"/>
                            <Border BorderBrush="#1A5C1A" BorderThickness="1" Background="#060D06" CornerRadius="4" Padding="4" Margin="0,0,0,12">
                                <PasswordBox FontSize="13" FontFamily="Consolas, Segoe UI" Foreground="#C8FFC8" CaretBrush="#00FF41"
                                             Background="Transparent" BorderThickness="0" Padding="6,4"
                                             helpers:PasswordBoxHelper.Attach="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmNewPasswordAfterRecovery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>

                            <TextBlock Text="âš  This will reset your vault. All saved passwords will be lost."
                                       FontSize="10" FontFamily="Consolas, Segoe UI" Foreground="#7A4A1A"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Button Content="ðŸ”“ RECOVER VAULT"
                                    Command="{Binding RecoverVaultCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="36" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- BUSY OVERLAY (Loading spinner indicator) -->
                <Border Background="#EE060D06"
                        BorderBrush="#00FF41"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="160" Height="6" Foreground="#00FF41" Background="#0D1A0D" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding BusyMessage}" FontSize="14" FontFamily="Consolas, Segoe UI" FontWeight="Bold" Foreground="#00FF41" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
