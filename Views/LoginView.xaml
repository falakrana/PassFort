<UserControl x:Class="PasswordManager.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:PasswordManager.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="650">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Background="#F1F5F9">
        <Border Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="12"
                Padding="36"
                Effect="{DynamicResource ShadowEffect}">
            <Border.Resources>
                <DropShadowEffect x:Key="ShadowEffect" BlurRadius="24" ShadowDepth="4" Direction="270" Color="#20000000" />
            </Border.Resources>

            <Grid>
                <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <!-- Lock Icon Header -->
                    <Border Background="#EFF6FF" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="🔒" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Title & Subtitle -->
                    <TextBlock Text="{Binding Title}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="13"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>

                    <!-- Error Message Banner -->
                    <Border Background="#FEF2F2"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,18"
                            Visibility="{Binding ErrorMessage, Converter={x:Static helpers:NullToVisibilityConverter.Instance}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#991B1B"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Password Input with Masking Toggle -->
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Master Password"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   DockPanel.Dock="Left" />
                        <Button Content="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}, StringFormat='👁️ Show', ConverterParameter='👁️ Hide'}"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                Foreground="#2563EB"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right" />
                    </DockPanel>

                    <!-- Masked Password Box -->
                    <Border BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}}">
                        <PasswordBox x:Name="MasterPasswordBox"
                                     FontSize="14"
                                     BorderThickness="0"
                                     Padding="6,4"
                                     helpers:PasswordBoxHelper.Attach="True"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <!-- Unmasked Password Box -->
                    <Border BorderBrush="#2563EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 BorderThickness="0"
                                 Padding="6,4" />
                    </Border>

                    <!-- Confirm Password Input (First Run Only) -->
                    <StackPanel Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Confirm Master Password"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,6" />

                        <Border BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4"
                                Margin="0,0,0,16">
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         FontSize="14"
                                         BorderThickness="0"
                                         Padding="6,4"
                                         helpers:PasswordBoxHelper.Attach="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                    </StackPanel>

                    <!-- Action Button: Setup Master Password (First Run) -->
                    <Button Content="Create Master Password &amp; Unlock Vault"
                            Command="{Binding SetupCommand}"
                            IsDefault="True"
                            Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="42"
                            FontSize="14"
                            Margin="0,8,0,0" />

                    <!-- Action Button: Unlock Vault (Existing Vault) -->
                    <Button Content="🔓 Unlock Vault"
                            Command="{Binding UnlockCommand}"
                            IsDefault="True"
                            Visibility="{Binding IsFirstRun, Converter={StaticResource InverseBoolToVis}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="42"
                            FontSize="14"
                            Margin="0,8,0,0" />
                </StackPanel>

                <!-- BUSY OVERLAY (Loading spinner indicator) -->
                <Border Background="#CCFFFFFF"
                        CornerRadius="12"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="160" Height="6" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding BusyMessage}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
