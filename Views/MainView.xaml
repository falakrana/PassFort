<UserControl x:Class="PasswordManager.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:PasswordManager.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="980">

    <UserControl.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVis"/>
        <helpers:InverseNullToVisibilityConverter x:Key="InvNullToVis"/>
    </UserControl.Resources>

    <Grid Background="#060D06">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP NAVIGATION HEADER -->
        <Border Grid.Row="0" Background="#020A02" BorderBrush="#1A5C1A" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🛡️ " FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" Foreground="#00FF41" FontFamily="Consolas, Segoe UI" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    
                    <!-- Passwords Count Counter Badge -->
                    <Border Background="#0F2B0F" BorderBrush="#00FF41" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsVaultUnlocked, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TotalEntriesCount}" Foreground="#00FF41" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text=" PASSWORDS" Foreground="#4A7A4A" FontFamily="Consolas, Segoe UI" FontSize="11" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Visibility="{Binding IsVaultUnlocked, Converter={StaticResource BoolToVis}}">
                    <Button Content="⚙️ SETTINGS" Command="{Binding OpenSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="0,0,10,0"/>
                    <Button Content="🔒 LOCK VAULT (Ctrl+L)" Command="{Binding LockCommand}" Style="{StaticResource DangerButtonStyle}" Padding="12,6"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- LOGIN CONTAINER (Visible when vault is locked) -->
        <Grid Grid.Row="1" Visibility="{Binding IsVaultUnlocked, Converter={StaticResource InvBoolToVis}}">
            <ContentControl Content="{Binding LoginViewModel}"/>
        </Grid>

        <!-- VAULT MAIN WORKSPACE (Visible when vault is unlocked) -->
        <Grid Grid.Row="1" Margin="20" Visibility="{Binding IsVaultUnlocked, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Search, Category Filter & Password List -->
            <Border Grid.Column="0" Background="#0D1A0D" CornerRadius="8" Padding="16" Margin="0,0,16,0" BorderBrush="#1A5C1A" BorderThickness="1"
                    Effect="{DynamicResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Add New Password Button (Ctrl+N) -->
                    <Button Grid.Row="0" Content="➕ ADD NEW PASSWORD (Ctrl+N)" Command="{Binding AddNewCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,12"/>

                    <!-- Search Input Box (Ctrl+F) -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource FormTextBoxStyle}" 
                                 Margin="0"
                                 Padding="10,8"/>
                        <!-- Watermark Overlay when empty -->
                        <TextBlock Grid.Column="0" 
                                   Text="🔍 Search entries... (Ctrl+F)" 
                                   Foreground="#2A5C2A" 
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="13" 
                                   VerticalAlignment="Center" 
                                   Margin="12,0,0,0" 
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource InvNullToVis}}"/>
                        <Button Grid.Column="1" 
                                Content="❌" 
                                Command="{Binding ClearSearchCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Padding="8,6" 
                                Margin="4,0,0,0"
                                ToolTip="Clear Search"/>
                    </Grid>

                    <!-- Category Filter Dropdown -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="CATEGORY: " FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <ComboBox ItemsSource="{Binding CategoriesFilterList}" 
                                  SelectedItem="{Binding SelectedCategoryFilter}" 
                                  Padding="8,6" 
                                  FontSize="13" 
                                  FontFamily="Consolas, Segoe UI"
                                  Foreground="#C8FFC8"
                                  Background="#060D06"/>
                    </DockPanel>

                    <!-- PASSWORD ENTRIES CONTAINER (List or Empty States) -->
                    <Grid Grid.Row="3">
                        <!-- LIST OF ENTRIES (Shown when HasEntries is True) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}">
                            <ListBox ItemsSource="{Binding FilteredEntries}" 
                                     SelectedItem="{Binding SelectedEntry}"
                                     BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="#0A1A0A" BorderBrush="#1A3D1A" BorderThickness="1" CornerRadius="4" Padding="12">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#0F2B0F"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00FF41"/>
                                                            <Setter TargetName="ItemBorder" Property="Effect" Value="{StaticResource CardShadow}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#112B11"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#265926"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#0F2B0F" BorderBrush="#00FF41" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontFamily="Consolas, Segoe UI" FontWeight="Bold" Foreground="#00FF41"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontFamily="Consolas, Segoe UI" FontSize="14" Foreground="#C8FFC8"/>
                                                <TextBlock Text="{Binding Username}" FontSize="12" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>

                        <!-- EMPTY STATE 1: EMPTY VAULT (0 items in vault) -->
                        <Border Background="#0A1A0A" CornerRadius="6" BorderBrush="#1A5C1A" BorderThickness="1" Padding="20"
                                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                Visibility="{Binding IsEmptyVault, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📂" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="VAULT IS EMPTY" FontSize="15" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#00FF41" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="You don't have any saved passwords yet. Click below to add your first entry."
                                           FontSize="12" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Button Content="➕ Add First Password" Command="{Binding AddNewCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- EMPTY STATE 2: NO SEARCH RESULTS (0 items matching search/filter) -->
                        <Border Background="#0A1A0A" CornerRadius="6" BorderBrush="#1A5C1A" BorderThickness="1" Padding="20"
                                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="NO ENTRIES FOUND" FontSize="15" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#00FF41" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="No passwords match your search query or category filter."
                                           FontSize="12" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Button Content="❌ Clear Search Filter" Command="{Binding ClearSearchCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT MAIN PANEL: Password Details OR Add/Edit Form -->
            <Grid Grid.Column="1">
                <!-- VIEW 1: DETAIL VIEW MODE -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedEntry, Converter={StaticResource NullToVis}}" Value="Visible"/>
                                        <Condition Binding="{Binding IsEditing}" Value="False"/>
                                        <Condition Binding="{Binding IsAdding}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Background="#0D1A0D" CornerRadius="8" Padding="28" BorderBrush="#1A5C1A" BorderThickness="1"
                                Effect="{DynamicResource CardShadow}">
                            <StackPanel>
                                <!-- Top Bar of Detail Card -->
                                <DockPanel Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding SelectedEntry.Title}" FontSize="22" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#00FF41" VerticalAlignment="Center"/>
                                        <Border Background="#0F2B0F" BorderBrush="#00FF41" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedEntry.Category, StringFormat='[{0}]'}" FontSize="12" FontFamily="Consolas, Segoe UI" FontWeight="Bold" Foreground="#00FF41"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button Content="✏️ EDIT" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                        <Button Content="🗑️ DELETE" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButtonStyle}"/>
                                    </StackPanel>
                                </DockPanel>

                                <Separator Background="#1A5C1A" Margin="0,0,0,20"/>

                                <!-- Username Field -->
                                <TextBlock Text=">_ USERNAME / EMAIL" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SelectedEntry.Username, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="16" FontFamily="Consolas, Segoe UI" Foreground="#C8FFC8" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="📋 COPY USERNAME" Command="{Binding CopyUsernameCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>

                                <!-- Password Field with Masking Toggle and Copy -->
                                <TextBlock Text=">_ PASSWORD" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Masked Password -->
                                    <TextBlock Grid.Column="0" Text="••••••••••••••••" FontSize="16" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" VerticalAlignment="Center"
                                               Visibility="{Binding IsPasswordVisible, Converter={StaticResource InvBoolToVis}}"/>

                                    <!-- Unmasked Password -->
                                    <TextBox Grid.Column="0" Text="{Binding SelectedEntry.Password, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="16" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#00FF41" VerticalAlignment="Center"
                                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{Binding IsPasswordVisible, Converter={StaticResource InvBoolToVis}, StringFormat='👁️ Show', ConverterParameter='👁️ Hide'}" 
                                                Command="{Binding TogglePasswordVisibilityCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                        <Button Content="📋 COPY PASSWORD" Command="{Binding CopyPasswordCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Website Field -->
                                <TextBlock Text=">_ WEBSITE URL" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedEntry.WebsiteUrl, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="14" FontFamily="Consolas, Segoe UI" Foreground="#00FF41" Margin="0,0,0,18"/>

                                <!-- Notes Field -->
                                <TextBlock Text=">_ NOTES" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" Margin="0,0,0,4"/>
                                <Border Background="#060D06" CornerRadius="4" Padding="14" Margin="0,0,0,18" BorderBrush="#1A5C1A" BorderThickness="1">
                                    <TextBlock Text="{Binding SelectedEntry.Notes}" FontSize="13" FontFamily="Consolas, Segoe UI" Foreground="#C8FFC8" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Timestamps -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="CREATED: " FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="#2A5C2A"/>
                                    <TextBlock Text="{Binding SelectedEntry.CreatedAt, StringFormat={}{0:g}}" FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="#2A5C2A"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 2: ADD / EDIT FORM MODE -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAdding}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Background="#0D1A0D" CornerRadius="8" Padding="28" BorderBrush="#1A5C1A" BorderThickness="1"
                                Effect="{DynamicResource CardShadow}">
                            <StackPanel>
                                <TextBlock Text=">_ ADD NEW PASSWORD ENTRY" 
                                           FontSize="18" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#00FF41" Margin="0,0,0,15"
                                           Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text=">_ EDIT PASSWORD ENTRY" 
                                           FontSize="18" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#00FF41" Margin="0,0,0,15"
                                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>

                                <!-- Validation Error Alert -->
                                <Border Background="#2B0000" BorderBrush="#FF2222" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16"
                                        Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FF6666" FontFamily="Consolas, Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Form Inputs -->
                                <TextBlock Text="Title *" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A"/>
                                <TextBox Text="{Binding EditingEntry.Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock Text="Username / Email" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A"/>
                                <TextBox Text="{Binding EditingEntry.Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                                <!-- Password Field with Toggle and Auto Generator Button -->
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Password *" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" DockPanel.Dock="Left"/>
                                    <Button Content="{Binding IsEditingPasswordVisible, Converter={StaticResource InvBoolToVis}, StringFormat='👁️ Show', ConverterParameter='👁️ Hide'}"
                                            Command="{Binding ToggleEditingPasswordVisibilityCommand}"
                                            Foreground="#00FF41" Background="Transparent" BorderThickness="0" FontSize="11" FontFamily="Consolas, Segoe UI" FontWeight="Bold" Cursor="Hand" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>
                                
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Masked Password -->
                                    <TextBox Grid.Column="0" Text="{Binding EditingEntry.Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Margin="0"
                                             Visibility="{Binding IsEditingPasswordVisible, Converter={StaticResource InvBoolToVis}}"/>
                                    
                                    <!-- Unmasked Password -->
                                    <TextBox Grid.Column="0" Text="{Binding EditingEntry.Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Margin="0" Foreground="#00FF41" FontWeight="Bold"
                                             Visibility="{Binding IsEditingPasswordVisible, Converter={StaticResource BoolToVis}}"/>

                                    <Button Grid.Column="1" 
                                            Content="⚡ AUTO GENERATE" 
                                            Command="{Binding GeneratePasswordForEntryCommand}" 
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Margin="8,0,0,0" 
                                            Padding="10,6"/>
                                </Grid>

                                <!-- Embedded Password Generator Options Panel -->
                                <Border Background="#060D06" BorderBrush="#1A5C1A" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,16">
                                    <StackPanel DataContext="{Binding PasswordGeneratorViewModel}">
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="⚙️ GENERATOR SETTINGS" FontSize="12" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#00FF41" VerticalAlignment="Center"/>
                                            <Button Content="📋 COPY GENERATED" Command="{Binding CopyCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="8,4" FontSize="11"/>
                                        </DockPanel>

                                        <!-- Length Slider -->
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Length: " FontSize="12" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Length}" FontSize="12" FontFamily="Consolas, Segoe UI" FontWeight="Bold" Foreground="#00FF41" Width="30" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding Length, Mode=TwoWay}" Minimum="4" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- Character Options Checkboxes -->
                                        <WrapPanel Margin="0,0,0,10">
                                            <CheckBox Content="A-Z Uppercase" IsChecked="{Binding IncludeUppercase}" Foreground="#C8FFC8" FontFamily="Consolas, Segoe UI" Margin="0,0,15,6" FontSize="12"/>
                                            <CheckBox Content="a-z Lowercase" IsChecked="{Binding IncludeLowercase}" Foreground="#C8FFC8" FontFamily="Consolas, Segoe UI" Margin="0,0,15,6" FontSize="12"/>
                                            <CheckBox Content="0-9 Numbers" IsChecked="{Binding IncludeNumbers}" Foreground="#C8FFC8" FontFamily="Consolas, Segoe UI" Margin="0,0,15,6" FontSize="12"/>
                                            <CheckBox Content="!@# Symbols" IsChecked="{Binding IncludeSymbols}" Foreground="#C8FFC8" FontFamily="Consolas, Segoe UI" Margin="0,0,15,6" FontSize="12"/>
                                        </WrapPanel>

                                        <!-- Generator Error Alert -->
                                        <Border Background="#2B0000" BorderBrush="#FF2222" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,8"
                                                Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVis}}">
                                            <TextBlock Text="{Binding ValidationMessage}" Foreground="#FF6666" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Website URL" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A"/>
                                <TextBox Text="{Binding EditingEntry.WebsiteUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock Text="Category" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A"/>
                                <ComboBox ItemsSource="{Binding CategoriesList}" Text="{Binding EditingEntry.Category, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Padding="10,8" FontSize="14" FontFamily="Consolas, Segoe UI" Foreground="#C8FFC8" Margin="0,4,0,12" Background="#060D06"/>

                                <TextBlock Text="Notes" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A"/>
                                <TextBox Text="{Binding EditingEntry.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" Style="{StaticResource FormTextBoxStyle}"/>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="CANCEL (Esc)" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                                    <Button Content="💾 SAVE PASSWORD" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- GLOBAL WORKSPACE BUSY OVERLAY (Loading state indicator) -->
            <Border Grid.ColumnSpan="2" Background="#EE060D06" CornerRadius="8"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <Border Background="#0D1A0D" BorderBrush="#00FF41" BorderThickness="1" CornerRadius="8" Padding="30,20" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Effect="{DynamicResource ModalShadow}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="6" Foreground="#00FF41" Background="#060D06" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding BusyMessage}" FontSize="14" FontFamily="Consolas, Segoe UI" FontWeight="Bold" Foreground="#00FF41" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- PROFILE / CHANGE MASTER PASSWORD SETTINGS OVERLAY -->
            <Border Grid.ColumnSpan="2" Background="#EE060D06" CornerRadius="8"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="#0D1A0D" BorderBrush="#00FF41" BorderThickness="1" CornerRadius="8" Padding="28" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Effect="{DynamicResource ModalShadow}">
                    <StackPanel>
                        <!-- Header -->
                        <DockPanel Margin="0,0,0,18">
                            <TextBlock Text="⚙️ PROFILE SETTINGS" FontSize="18" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#00FF41" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button Content="❌" Command="{Binding CloseSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                        </DockPanel>

                        <TextBlock Text="Change your master password to re-encrypt your vault." FontSize="12" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" Margin="0,0,0,16"/>

                        <!-- Error Message Banner -->
                        <Border Background="#2B0000" BorderBrush="#FF2222" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,14"
                                Visibility="{Binding ChangePasswordErrorMessage, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding ChangePasswordErrorMessage}" Foreground="#FF6666" FontFamily="Consolas, Segoe UI" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Success Message Banner -->
                        <Border Background="#0B2B0B" BorderBrush="#00FF41" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,14"
                                Visibility="{Binding ChangePasswordSuccessMessage, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding ChangePasswordSuccessMessage}" Foreground="#00FF41" FontFamily="Consolas, Segoe UI" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Current Master Password -->
                        <TextBlock Text="CURRENT MASTER PASSWORD" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" Margin="0,0,0,4"/>
                        <Border BorderBrush="#1A5C1A" BorderThickness="1" Background="#060D06" CornerRadius="4" Padding="4" Margin="0,0,0,12">
                            <PasswordBox FontSize="14" FontFamily="Consolas, Segoe UI" Foreground="#C8FFC8" CaretBrush="#00FF41" Background="Transparent" BorderThickness="0" Padding="6,4"
                                         helpers:PasswordBoxHelper.Attach="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding CurrentMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>

                        <!-- New Master Password -->
                        <TextBlock Text="NEW MASTER PASSWORD" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" Margin="0,0,0,4"/>
                        <Border BorderBrush="#1A5C1A" BorderThickness="1" Background="#060D06" CornerRadius="4" Padding="4" Margin="0,0,0,12">
                            <PasswordBox FontSize="14" FontFamily="Consolas, Segoe UI" Foreground="#C8FFC8" CaretBrush="#00FF41" Background="Transparent" BorderThickness="0" Padding="6,4"
                                         helpers:PasswordBoxHelper.Attach="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding NewMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>

                        <!-- Confirm New Master Password -->
                        <TextBlock Text="CONFIRM NEW MASTER PASSWORD" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A" Margin="0,0,0,4"/>
                        <Border BorderBrush="#1A5C1A" BorderThickness="1" Background="#060D06" CornerRadius="4" Padding="4" Margin="0,0,0,20">
                            <PasswordBox FontSize="14" FontFamily="Consolas, Segoe UI" Foreground="#C8FFC8" CaretBrush="#00FF41" Background="Transparent" BorderThickness="0" Padding="6,4"
                                         helpers:PasswordBoxHelper.Attach="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmNewMasterPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="CANCEL" Command="{Binding CloseSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="14,8"/>
                            <Button Content="🔑 CHANGE MASTER PASSWORD" Command="{Binding ChangeMasterPasswordCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- BOTTOM FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#020A02" BorderBrush="#1A5C1A" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="STATUS: " FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#4A7A4A"/>
                    <TextBlock Text="{Binding StatusMessage}" FontFamily="Consolas, Segoe UI" Foreground="#00FF41"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Visibility="{Binding IsVaultUnlocked, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Showing " Foreground="#4A7A4A" FontFamily="Consolas, Segoe UI" FontSize="11"/>
                    <TextBlock Text="{Binding FilteredEntriesCount}" Foreground="#00FF41" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text=" of " Foreground="#4A7A4A" FontFamily="Consolas, Segoe UI" FontSize="11"/>
                    <TextBlock Text="{Binding TotalEntriesCount}" Foreground="#00FF41" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text=" entries" Foreground="#4A7A4A" FontFamily="Consolas, Segoe UI" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
