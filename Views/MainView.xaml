<UserControl x:Class="PasswordManager.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:PasswordManager.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">

    <UserControl.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVis"/>
        <helpers:InverseNullToVisibilityConverter x:Key="InvNullToVis"/>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#9CA3AF"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input TextBox Style -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Header -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,15">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🛡️ " FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Visibility="{Binding IsVaultUnlocked, Converter={StaticResource BoolToVis}}">
                    <Button Content="🔒 Lock Vault" Command="{Binding LockCommand}" Style="{StaticResource DangerButtonStyle}" Padding="12,6"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Login View Container (Shown when vault is locked) -->
        <Grid Grid.Row="1" Visibility="{Binding IsVaultUnlocked, Converter={StaticResource InvBoolToVis}}">
            <ContentControl Content="{Binding LoginViewModel}"/>
        </Grid>

        <!-- Vault Main Workspace (Shown when vault is unlocked) -->
        <Grid Grid.Row="1" Margin="20" Visibility="{Binding IsVaultUnlocked, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Search, Category Filter & Entries List -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="15" Margin="0,0,15,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Add New Password Button -->
                    <Button Grid.Row="0" Content="➕ Add New Password" Command="{Binding AddNewCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,12"/>

                    <!-- Search Input Box -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource FormTextBoxStyle}" 
                                 Margin="0"
                                 Padding="10,8"/>
                        <!-- Watermark Overlay when empty -->
                        <TextBlock Grid.Column="0" 
                                   Text="🔍 Search entries..." 
                                   Foreground="#94A3B8" 
                                   FontSize="13" 
                                   VerticalAlignment="Center" 
                                   Margin="12,0,0,0" 
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource InvNullToVis}}"/>
                        <Button Grid.Column="1" 
                                Content="❌" 
                                Command="{Binding ClearSearchCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Padding="8,6" 
                                Margin="4,0,0,0"/>
                    </Grid>

                    <!-- Category Filter Dropdown -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="Category: " FontSize="12" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <ComboBox ItemsSource="{Binding CategoriesFilterList}" 
                                  SelectedItem="{Binding SelectedCategoryFilter}" 
                                  Padding="8,6" 
                                  FontSize="13" 
                                  Background="White"/>
                    </DockPanel>

                    <!-- Password Entries List -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding FilteredEntries}" 
                                 SelectedItem="{Binding SelectedEntry}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3B82F6"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="#E2E8F0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                            <TextBlock Text="{Binding Username}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT MAIN PANEL: Password Details OR Add/Edit Form -->
            <Grid Grid.Column="1">
                <!-- VIEW 1: DETAIL VIEW MODE -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedEntry, Converter={StaticResource NullToVis}}" Value="Visible"/>
                                        <Condition Binding="{Binding IsEditing}" Value="False"/>
                                        <Condition Binding="{Binding IsAdding}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Background="White" CornerRadius="12" Padding="25" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
                            </Border.Effect>

                            <StackPanel>
                                <!-- Top Bar of Detail Card -->
                                <DockPanel Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding SelectedEntry.Title}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <Border Background="#E0F2FE" CornerRadius="6" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedEntry.Category}" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button Content="✏️ Edit" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                        <Button Content="🗑️ Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButtonStyle}"/>
                                    </StackPanel>
                                </DockPanel>

                                <Separator Background="#E2E8F0" Margin="0,0,0,20"/>

                                <!-- Username Field -->
                                <TextBlock Text="USERNAME / EMAIL" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SelectedEntry.Username, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="📋 Copy Username" Command="{Binding CopyUsernameCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>

                                <!-- Password Field with Masking Toggle and Copy -->
                                <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Masked Password -->
                                    <TextBlock Grid.Column="0" Text="••••••••••••••••" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"
                                               Visibility="{Binding IsPasswordVisible, Converter={StaticResource InvBoolToVis}}"/>

                                    <!-- Unmasked Password -->
                                    <TextBox Grid.Column="0" Text="{Binding SelectedEntry.Password, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="16" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"
                                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="👁️ Toggle" Command="{Binding TogglePasswordVisibilityCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                        <Button Content="📋 Copy Password" Command="{Binding CopyPasswordCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Website Field -->
                                <TextBlock Text="WEBSITE URL" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedEntry.WebsiteUrl, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="14" Foreground="#2563EB" Margin="0,0,0,16"/>

                                <!-- Notes Field -->
                                <TextBlock Text="NOTES" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding SelectedEntry.Notes}" FontSize="13" Foreground="#334155" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Timestamps -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Created: " FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding SelectedEntry.CreatedAt, StringFormat={}{0:g}}" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 2: ADD / EDIT FORM MODE -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAdding}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Background="White" CornerRadius="12" Padding="25" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Add New Password" 
                                           FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"
                                           Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="Edit Password Entry" 
                                           FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"
                                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>

                                <!-- Validation Error Alert -->
                                <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15"
                                        Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#991B1B" FontWeight="SemiBold"/>
                                </Border>

                                <!-- Form Inputs -->
                                <TextBlock Text="Title *" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Text="{Binding EditingEntry.Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock Text="Username / Email" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Text="{Binding EditingEntry.Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                                <!-- Password Field with Quick Generator Button -->
                                <TextBlock Text="Password *" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding EditingEntry.Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" Margin="0"/>
                                    <Button Grid.Column="1" 
                                            Content="⚡ Auto Generate" 
                                            Command="{Binding GeneratePasswordForEntryCommand}" 
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Margin="8,0,0,0" 
                                            Padding="10,6"/>
                                </Grid>

                                <!-- Embedded Password Generator Options Panel -->
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,16">
                                    <StackPanel DataContext="{Binding PasswordGeneratorViewModel}">
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="⚙️ Password Generator Settings" FontSize="13" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                            <Button Content="📋 Copy Generated" Command="{Binding CopyCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="8,4" FontSize="11"/>
                                        </DockPanel>

                                        <!-- Length Slider -->
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Length: " FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Length}" FontSize="12" FontWeight="Bold" Foreground="#2563EB" Width="30" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding Length, Mode=TwoWay}" Minimum="4" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- Character Options Checkboxes -->
                                        <WrapPanel Margin="0,0,0,10">
                                            <CheckBox Content="A-Z Uppercase" IsChecked="{Binding IncludeUppercase}" Margin="0,0,15,6" FontSize="12"/>
                                            <CheckBox Content="a-z Lowercase" IsChecked="{Binding IncludeLowercase}" Margin="0,0,15,6" FontSize="12"/>
                                            <CheckBox Content="0-9 Numbers" IsChecked="{Binding IncludeNumbers}" Margin="0,0,15,6" FontSize="12"/>
                                            <CheckBox Content="!@# Symbols" IsChecked="{Binding IncludeSymbols}" Margin="0,0,15,6" FontSize="12"/>
                                        </WrapPanel>

                                        <!-- Generator Error Alert -->
                                        <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,8"
                                                Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVis}}">
                                            <TextBlock Text="{Binding ValidationMessage}" Foreground="#991B1B" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Website URL" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Text="{Binding EditingEntry.WebsiteUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock Text="Category" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                <ComboBox ItemsSource="{Binding CategoriesList}" Text="{Binding EditingEntry.Category, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Padding="10,8" FontSize="14" Margin="0,4,0,12" Background="White"/>

                                <TextBlock Text="Notes" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Text="{Binding EditingEntry.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" Style="{StaticResource FormTextBoxStyle}"/>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                                    <Button Content="Save Password" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Footer Status Bar -->
        <Border Grid.Row="2" Background="#E2E8F0" Padding="15,8">
            <DockPanel>
                <TextBlock Text="Status: " FontWeight="SemiBold" Foreground="#475569"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1E293B"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
